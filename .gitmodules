[submodule ".registry"]
	path = .registry
	url = https://github.com/psychometrician/psychometrician.r-universe.dev
	branch = HEAD
[submodule "fathom"]
	path = fathom
	url = https://github.com/psychometrician/fathom
	subdir = r-pkg/fathom
[submodule "god"]
	path = god
	url = https://github.com/psychometrician/god
	subdir = r-pkg/god
[submodule "gog"]
	path = gog
	url = https://github.com/psychometrician/gog
	subdir = r-pkg/gog
